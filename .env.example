# Optional: external dashboard / usage URL for the /api/usage route
# Default: http://localhost:1430/v1
DMRXAI_API_URL=http://localhost:1430/v1

# Trakteer Public API key for the donation/support widget (/api/donation)
TRAKTEER_API_KEY=

# Public app URL used as the OAuth callback origin. If unset, the client
# falls back to window.location.origin. Set this in production so providers
# always redirect back to a known host.
NEXT_PUBLIC_APP_URL=https://your-app.com

# Optional external dashboard URL the /dashboard page redirects to.
# Must be an absolute http(s) URL. Leave empty to redirect to "/" instead.
NEXT_PUBLIC_DASHBOARD_URL=

# Comma-separated allowlist of hostnames the server may fetch when proxying
# AI / tool requests. Used by app/lib/url-guard.ts. Example:
# ALLOWED_AI_HOSTS=api.openai.com,api.anthropic.com
ALLOWED_AI_HOSTS=

# ---- App Builder Sandbox ----
# Backend sandbox for the App Builder agent. Options: "docker" (default,
# self-hosted) or "e2b" (cloud). See app/lib/sandbox-provider.ts.
DMRXAI_SANDBOX_PROVIDER=docker

# Base directory (on the host) where each project's sandbox workspace lives.
# Each project gets its own subdirectory: <DMRXAI_SANDBOX_DIR>/<projectSlug>.
DMRXAI_SANDBOX_DIR=/srv/dmrxai/sandboxes

# Public base host for wildcard preview subdomains, e.g.
# https://<projectSlug>.preview.devplay.online (wildcard level-1, free tier).
DMRXAI_PREVIEW_HOST=https://preview.devplay.online

# Base Docker image for sandbox containers (Node pre-installed).
DMRXAI_SANDBOX_IMAGE=node:20-alpine

# ---- E2B Sandbox (alternative backend) ----
# Only used when DMRXAI_SANDBOX_PROVIDER=e2b. Leave empty when using Docker.
E2B_API_KEY=

# Sandbox template id. Defaults to "base" (Node pre-installed).
E2B_TEMPLATE=base
