# Caddy — dmrxai preview router
#
# Arsitektur: traffic publik masuk via Cloudflare Tunnel (TLS di edge Cloudflare),
# lalu tunnel meneruskan *.preview.devplay.online ke caddy:8080.
# Karena TLS sudah di-handle Cloudflare, Caddy berjalan HTTP saja.
#
# Routing: <slug>.preview.devplay.online -> container sandbox "dmrxai-sb-<slug>"
# di network dmrxai-sandbox-net, port 5173 (default Vite dev server).

{
	auto_https off
	admin off
}

http://*.preview.devplay.online:8080 {
	handle {
		# {labels.3} = label subdomain pertama.
		# contoh: foo.preview.devplay.online -> dmrxai-sb-foo:5173
		reverse_proxy dmrxai-sb-{labels.3}:5173 {
			flush_interval -1
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}
