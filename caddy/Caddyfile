# Caddy — dmrxai preview router (path-based)
#
# Arsitektur: traffic publik masuk via Cloudflare Tunnel (TLS di edge Cloudflare),
# lalu tunnel meneruskan preview.devplay.online ke caddy:8080.
# Karena TLS sudah di-handle Cloudflare, Caddy berjalan HTTP saja.
#
# Routing: /<slug> -> container sandbox "dmrxai-sb-<slug>" di network
# dmrxai-sandbox-net, port 5173 (default Vite dev server).

{
	auto_https off
	admin off
}

http://preview.devplay.online:8080 {
	@preview path_regexp ^\/([^\/]+)\/?
	handle @preview {
		reverse_proxy dmrxai-sb-{re.1}:5173 {
			flush_interval -1
			# Vite dev server blocks non-localhost Host headers by default.
			# Rewrite Host to localhost so Vite accepts the request; keep the
			# original host in X-Forwarded-Host for the app if it needs it.
			header_up Host localhost
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}
