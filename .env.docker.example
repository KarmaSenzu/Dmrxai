# Docker Compose env file untuk Dmr x AI.
# Copy ke .env lalu isi nilai-nilainya. JANGAN commit .env ke git.

# Timezone
TZ=Asia/Jakarta

# ---- AI Backend (9Router) ----
# Base URL ke 9Router internal (container-to-container).
# Default sudah mengarah ke service `9router` di network dmrxai-net.
AI_BASE_URL=http://9router:20128/v1

# API Key dari 9Router dashboard.
# 1. Buka https://9router.devplay.online/dashboard
# 2. Connect provider (Kiro AI free, OpenCode free, atau provider berbayar)
# 3. Copy API key yang di-generate, paste di sini
# 4. Restart: docker compose up -d app
AI_API_KEY=

# ---- Supabase (Auth + Database) ----
# Client-side vars (NEXT_PUBLIC_ — aman untuk browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key (JANGAN pernah expose ke browser).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Legacy ----
# DMRXAI_API_URL untuk fitur Usage Dashboard (server lisensi custom).
# Tidak dipakai dengan setup 9Router. Biarkan kosong.
DMRXAI_API_URL=

# ---- Donasi (Trakteer) ----
# Trakteer Public API key untuk widget "support the server" (/api/donation).
# Ambil dari menu "Public API" di dashboard Trakteer. Header-nya bernama "key".
# Kosongkan -> UI tetap jalan, angka donasi tampil Rp 0 sampai key diisi.
TRAKTEER_API_KEY=

# ---- App Builder Sandbox ----
# Backend sandbox untuk agent App Builder. "docker" (default, self-host)
# atau "e2b" (cloud). Lihat app/lib/sandbox-provider.ts.
DMRXAI_SANDBOX_PROVIDER=docker

# Base directory (di host) untuk workspace sandbox per-project.
# Tiap project dapat subdirectory sendiri: <DMRXAI_SANDBOX_DIR>/<projectSlug>.
DMRXAI_SANDBOX_DIR=/srv/dmrxai/sandboxes

# Base host publik untuk wildcard preview subdomain, misal
# https://<projectSlug>.preview.devplay.online
DMRXAI_PREVIEW_HOST=https://preview.devplay.online

# Base Docker image untuk container sandbox (sudah include Node.js).
DMRXAI_SANDBOX_IMAGE=node:20-alpine

# ---- E2B Sandbox (alternatif) ----
# Hanya dipakai jika DMRXAI_SANDBOX_PROVIDER=e2b. Kosongkan saat pakai Docker.
E2B_API_KEY=

# Template sandbox (default "base" sudah include Node.js).
E2B_TEMPLATE=base
